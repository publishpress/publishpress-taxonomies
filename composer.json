{
    "name": "publishpress/publishpress-taxonomies",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "description": "",
    "authors": [
        {
            "name": "PublishPress",
            "email": "help@publishpress.com",
            "homepage": "https://publishpress.com",
            "role": "Developer"
        }
    ],
    "config": {
        "process-timeout": 0,
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "automattic/jetpack-autoloader": true,
            "php-http/discovery": true,
            "publishpress/dev-workspace": true,
            "phpstan/extension-installer": true,
            "composer/installers": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "automattic/vipwpcs": "^3",
        "publishpress/dev-workspace": "^2.1.0"
    },
    "scripts": {
        "lint:phpmd": "vendor/publishpress/dev-workspace/scripts/run.sh phpmd blocks,inc,includes-core,modules,review-request,views,simple-tags.php ansi phpmd.ruleset.xml",
        "lint:phpmd:ci": "vendor/publishpress/dev-workspace/scripts/run.sh phpmd blocks,inc,includes-core,modules,review-request,views,simple-tags.php github phpmd.ruleset.xml",
        "lint:phpmd:text": "vendor/publishpress/dev-workspace/scripts/run.sh phpmd blocks,inc,includes-core,modules,review-request,views,simple-tags.php text phpmd.ruleset.xml",
        "fix:php": [
            "php-cs-fixer fix .",
            "@fix:cs"
        ]
    },
    "scripts-descriptions": {
        "fix:php": "Fixes the PHP files."
    },
    "extra": {
        "plugin-slug": "simple-tags",
        "plugin-name": "publishpress-taxonomies",
        "plugin-folder": "simple-tags",
        "version-constant": "STAGS_VERSION",
        "plugin-lang-domain": "simple-tags",
        "plugin-github-repo": "publishpress/publishpress-taxonomies",
        "plugin-composer-package": "publishpress/publishpress-taxonomies"
    },
    "repositories": [{
        "name": "publishpress-phpcs-standards",
        "type": "vcs",
        "url": "https://github.com/publishpress/publishpress-phpcs-standards.git"
    }]
}
