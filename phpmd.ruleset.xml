<?xml version="1.0"?>
<ruleset name="PublishPress Taxonomies PHPMD Ruleset"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>PublishPress Taxonomies PHPMD Ruleset</description>

    <!-- Skip dependencies, generated files, and development-only directories. -->
    <exclude-pattern>*/.agents/*</exclude-pattern>
    <exclude-pattern>*/.claude/*</exclude-pattern>
    <exclude-pattern>*/.codegraph/*</exclude-pattern>
    <exclude-pattern>*/.cursor/*</exclude-pattern>
    <exclude-pattern>*/.ddev/*</exclude-pattern>
    <exclude-pattern>*/.git/*</exclude-pattern>
    <exclude-pattern>*/.github/*</exclude-pattern>
    <exclude-pattern>*/.idea/*</exclude-pattern>
    <exclude-pattern>*/.opencode/*</exclude-pattern>
    <exclude-pattern>*/.vscode/*</exclude-pattern>
    <exclude-pattern>*/.web/*</exclude-pattern>
    <exclude-pattern>*/.wordpress-org/*</exclude-pattern>
    <exclude-pattern>*/.zed/*</exclude-pattern>
    <exclude-pattern>*/.svn/*</exclude-pattern>
    <exclude-pattern>*/bin/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/dev-workspace/*</exclude-pattern>
    <exclude-pattern>*/dev-workspace-cache/*</exclude-pattern>
    <exclude-pattern>*/dist/*</exclude-pattern>
    <exclude-pattern>*/doc/*</exclude-pattern>
    <exclude-pattern>*/docs/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/lib/vendor/*</exclude-pattern>
    <exclude-pattern>*/metrics/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests-old/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/cache/*</exclude-pattern>
    <exclude-pattern>*/.cache/*</exclude-pattern>

    <!-- Included inside SimpleTags_Admin; PDepend parses templates outside that class scope. -->
    <exclude-pattern>*/views/admin/page-settings.php</exclude-pattern>

    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
        <exclude name="ElseExpression"/>
    </rule>

    <rule ref="rulesets/codesize.xml"/>

    <rule ref="rulesets/controversial.xml"/>

    <rule ref="rulesets/design.xml"/>

    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
    </rule>

    <rule ref="rulesets/unusedcode.xml"/>
</ruleset>
