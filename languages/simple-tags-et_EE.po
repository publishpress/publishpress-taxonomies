msgstr "Valikud sisaldavad linnukesi ja rippmenüüd."

#: includes-core/TaxopressCoreAdmin.php:744
msgid "Copy Term with Metadata"
msgstr "Kopeeri termin koos metaandmetega"

#: includes-core/TaxopressCoreAdmin.php:749
