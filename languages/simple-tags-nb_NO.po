#: review-request/review.php:279
#, php-format
msgid ""
"Hey, you've been using PublishPress Taxonomies for %s on your site. We hope "
"the plugin has been useful. Please could you quickly leave a 5-star rating "
"on WordPress.org? It really does help to keep PublishPress Taxonomies "
"growing."
msgstr ""
"Hei, du har brukt PublishPress Taxonomies for %s på nettstedet ditt. Vi "
"håper at plugin-en har vært nyttig. Kan du raskt legge igjen en 5-stjerners "
"vurdering på WordPress.org? Det hjelper virkelig å holde PublishPress "
"Taxonomies i vekst."

#: review-request/review.php:288
msgid "1 week"
msgstr "1 uke"

#: review-request/review.php:304
msgid "3 months"
msgstr "3 måneder"

#: review-request/review.php:369
msgid "Click here to add your rating for PublishPress Taxonomies"
msgstr "Klikk her for å legge til vurderingen din for PublishPress Taxonomies"

#: review-request/review.php:371
msgid "Maybe later"
msgstr "Kanskje senere"

#: review-request/review.php:373
msgid "I already did"
msgstr "Jeg har allerede gjort det"

