"apẹẹrẹ, \"weebụsaịtị\" le ni awọn ọrọ aiyipada bii \"weebụsaịtị\", \"weebụ "
"aaye\", ati \"weebụ oju-iwe\"."

#: includes-core/TaxopressCoreAdmin.php:676
msgid "Synonyms Terms Feature"
msgstr "Ẹya Awọn ọrọ aiyipada"

#: includes-core/TaxopressCoreAdmin.php:680
