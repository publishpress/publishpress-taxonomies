msgstr "Názov a slug musia mať maximálne 200 bajtov; hodnoty nie sú skrátené."

#: inc/class-taxopress-tag-csv-service.php:199
msgid "Description must be at most 10,000 bytes."
msgstr "Popis musí mať maximálne 10 000 bajtov."

#: inc/class-taxopress-tag-csv-service.php:203
msgid "Slug must already be a canonical WordPress slug and cannot be \"0\"."
msgstr "Slug musí byť už kanonický WordPress slug a nemôže byť \"0\"."

#: inc/class-taxopress-tag-csv-service.php:207
#. translators: %d: Earlier CSV record number.
#, php-format
msgid "Duplicate slug; first used in CSV record %d."
msgstr "Duplicitný slug; prvýkrát použitý v CSV zázname %d."

#: inc/class-taxopress-tag-csv-service.php:218
msgid "parent_slug must be a string."
msgstr "parent_slug musí byť reťazec."

#: inc/class-taxopress-tag-csv-service.php:224
msgid "parent_slug can only be used with a hierarchical taxonomy."
msgstr "parent_slug môže byť použitý iba s hierarchickou taxonomy."

#: inc/class-taxopress-tag-csv-service.php:227
msgid "parent_slug must be a different canonical WordPress slug."
msgstr "parent_slug musí identifikovať iný kanonický WordPress slug."

